# All paths are resolved relative to the project root unless absolute.
# Set to 0.0.0.0 if Windows cannot connect to the WSL server via localhost.
LABNOTE_HOST=127.0.0.1
LABNOTE_DATA_DIR=./data
LABNOTE_ATTACHMENTS_DIR=./data/attachments
LABNOTE_BACKUP_DIR=./backups
# Backups will be implemented in M7. This variable only reserves the path.
